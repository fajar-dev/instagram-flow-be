{
  "name": "hono-boilerplate",
  "scripts": {
    "dev": "bun run --hot src/index.ts",
    "build": "bun build --minify --outfile dist/index.js --target bun src/index.ts",
    "start": "bun run src/index.ts",
    "test": "bun test --timeout 30000",
    "migration:run": "bun run ./node_modules/typeorm/cli.js migration:run -d src/config/database.ts",
    "migration:revert": "bun run ./node_modules/typeorm/cli.js migration:revert -d src/config/database.ts",
    "migration:show": "bun run ./node_modules/typeorm/cli.js migration:show -d src/config/database.ts",
    "migration:generate": "bun run ./node_modules/typeorm/cli.js migration:generate",
    "migration:create": "bun run ./node_modules/typeorm/cli.js migration:create",
    "seed": "bun run src/database/seeders/index.ts",
    "seed:users": "bun run src/database/seeders/user.seeder.ts",
    "typecheck": "tsc --noEmit",
    "jobs:dispatch": "bun run src/commands/job-dispatch.ts",
    "posts:dispatch": "bun run src/commands/publication-dispatch.ts",
    "lint": "eslint src test integrations/n8n",
    "format": "eslint src test integrations/n8n --fix && prettier --write \"src/**/*.ts\" \"test/**/*.ts\" \"integrations/n8n/**/*.ts\" \"integrations/n8n/nodes/*.js\" && eslint src test integrations/n8n --fix && bun run integrations/n8n/build-workflow.ts",
    "brand:upload": "bun run src/commands/upload-design-reference.ts"
  },
  "dependencies": {
    "@azure/msal-node": "^7.1.1",
    "@hono/swagger-ui": "^0.6.1",
    "@hono/zod-validator": "^0.7.6",
    "bcryptjs": "^3.0.3",
    "google-auth-library": "^10.7.0",
    "hono": "^4.12.8",
    "ioredis": "^6.0.0",
    "minio": "^8.0.7",
    "mysql2": "^3.20.0",
    "nodemailer": "^8.0.3",
    "reflect-metadata": "^0.2.2",
    "sharp": "^0.35.5",
    "typeorm": "^0.3.28",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/bcryptjs": "^3.0.0",
    "@types/bun": "latest",
    "@types/nodemailer": "^7.0.11",
    "eslint": "^10.13.0",
    "prettier": "^3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.72.0"
  }
}
